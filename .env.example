# Public Cesium ion token used for imagery, terrain, and geocoding.
# Keep scopes minimal and restrict permitted application URLs. Never commit a real token.
VITE_CESIUM_ION_TOKEN=
# ID of an imagery asset available to this token (no account-specific default).
VITE_CESIUM_ION_IMAGERY_ASSET_ID=
# Optional transparent labels-only Cesium ion asset compatible with the base imagery.
VITE_CESIUM_ION_LABELS_ASSET_ID=
# Public vector style URL for the primary 2D map.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Backend-only routing credentials (never prefix with VITE_).
HEIGIT_API_KEY=
HEIGIT_BASE_URL=https://api.heigit.org/openrouteservice
DATABASE_URL=sqlite:///terrene.db
